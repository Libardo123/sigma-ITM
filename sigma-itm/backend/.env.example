# ================================================================
# .env.example — Backend SIGMA ITM
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas el archivo .env real al repositorio.
# ================================================================

# ── Seguridad ─────────────────────────────────────────────────
# Genera una clave segura con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-en-produccion

# Usa True en desarrollo, False en producción
DEBUG=True

# En producción lista los dominios/IPs del servidor separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos ─────────────────────────────────────────────
# Deja "sqlite" para desarrollo local sin instalar nada.
# Cambia a "postgres" y completa los datos para producción.
DB_ENGINE=sqlite

# Solo necesarios si DB_ENGINE=postgres
DB_NAME=sigma_itm
DB_USER=sigma_itm
DB_PASSWORD=cambia_esta_password
DB_HOST=localhost
DB_PORT=5432

# ── CORS ──────────────────────────────────────────────────────
# Orígenes del frontend autorizados para hacer peticiones a la API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Correo electrónico ────────────────────────────────────────
# "console" imprime los emails en el terminal (para desarrollo).
# Cambia a "smtp" y configura los datos para producción.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Solo necesarios si se usa SMTP
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion
# DEFAULT_FROM_EMAIL=noreply@sigma-itm.edu.co
